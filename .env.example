# Local development defaults. No external credentials required.
APP_MODE=local
PORT=4317
# DATA_DIR defaults to this checkout's .data directory.

# Production: set APP_MODE=production and all values below in a private env file
# or the hosting provider's secret configuration. Never commit filled values.
# NODE_ENV=production
# BASE_URL=https://your-product-domain.example
# Optional during a domain migration: retain old extension API and OAuth access.
# LEGACY_BASE_URL=https://previous-product-domain.example
# HOST=0.0.0.0
# DATA_DIR=/var/lib/annotated
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional X OAuth 2.0 confidential Web App. Set both to enable X sign-in.
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# EXTENSION_IDS=
# ADMIN_EMAILS=
# Optional production-build override for the Chrome Web Store public key.
# Never use a private signing key here.
# EXTENSION_PUBLIC_KEY=

# Vercel release: use Neon pooled Postgres and a PRIVATE Vercel Blob store.
# DATABASE_URL=
# MEDIA_STORAGE=blob
# BLOB_READ_WRITE_TOKEN=
# DATA_DIR=/tmp/annotated
# CRON_SECRET=
# ADMIN_DISPLAY_NAME=Your display name
# SUPPORT_EMAIL=
# Bounded preview capacity, shared by all accounts; failed attempts count.
# MEDIA_DAILY_UPLOAD_LIMIT=20
# MEDIA_MONTHLY_UPLOAD_LIMIT=200
# MEDIA_STORAGE_LIMIT_BYTES=1073741824
